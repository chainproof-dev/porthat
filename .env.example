# Site URL (for OG meta tags and canonical URLs)
VITE_SITE_URL=https://umar.ac

# Spotify Integration
# Get these from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
VITE_SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# To get your refresh token:
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Set redirect URI to http://localhost:3000/callback
# 3. Use the Authorization Code flow to get a refresh token
# 4. Required scopes: user-read-currently-playing, user-read-recently-played

# Giscus Comments Integration
# Get these from https://giscus.app after setting up your repo
VITE_GISCUS_REPO=chainproof-dev/porthat
VITE_GISCUS_REPO_ID=R_kgDOQ61GQw
VITE_GISCUS_CATEGORY=Blog Comments
VITE_GISCUS_CATEGORY_ID=DIC_kwDOQ61GQ84C1bZ2

# Umami Analytics (Privacy-first analytics)
# Sign up at https://cloud.umami.is or self-host
VITE_UMAMI_WEBSITE_ID=your_umami_website_id
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_UMAMI_DOMAINS=umar.ac
